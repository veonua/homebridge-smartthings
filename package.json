{
  "private": false,
  "displayName": "SmartThings Plugin",
  "name": "homebridge-smartthings-veon",
  "version": "25.6.97-local.18",
  "description": "Connects SmartThings devices to Homebridge.  Automatically discovers devices.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/veon/homebridge-smartthings.git"
  },
  "bugs": {
    "url": "https://github.com/veon/homebridge-smartthings/issues"
  },
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0",
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "pack": "npm run build && npm pack",
    "prepublishOnly": "npm run lint && npm run build",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test test/*.test.cjs test/*.test.mjs"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "supports-matter"
  ],
  "dependencies": {
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3",
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.2.2"
  },
  "funding": [
    {
      "type": "paypal",
      "url": "https://www.paypal.com/paypalme/iklein99"
    },
    {
      "type": "venmo",
      "url": "https://venmo.com/?txn=pay&audience=public&recipients=ira-klein-3"
    }
  ]
}
